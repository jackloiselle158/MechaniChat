# The API is intentionally bound to this computer during the prototype.
MECHANICHAT_API_HOST=127.0.0.1
MECHANICHAT_API_PORT=8000

MECHANICHAT_OLLAMA_URL=http://127.0.0.1:11434
MECHANICHAT_CHAT_MODEL=qwen3.5:4b
# qwen3.5:4b supports both vision and tools. Set this separately to try another vision model.
MECHANICHAT_VISION_MODEL=qwen3.5:4b
MECHANICHAT_MODEL_REASONING=false
MECHANICHAT_MODEL_CONTEXT_LENGTH=8192
MECHANICHAT_ROUTER_MODEL=huggingface.co/unsloth/Llama-3.2-3B-Instruct-GGUF:latest
MECHANICHAT_ROUTER_CONTEXT_LENGTH=2048
# Keep the small router on CPU so the response model keeps the limited GPU memory.
MECHANICHAT_ROUTER_NUM_GPU=0
MECHANICHAT_DATABASE_PATH=./mydb
MECHANICHAT_SOURCE_COLLECTION_NAME=docs
MECHANICHAT_MIGRATION_EMBEDDING_MODEL=embeddinggemma-2:270m
MECHANICHAT_MIGRATION_COLLECTION_NAME=docs_retrieval_v2

# Leave these unset to switch automatically after python db.py finishes.
# MECHANICHAT_EMBEDDING_MODEL=embeddinggemma-2:270m
# MECHANICHAT_COLLECTION_NAME=docs_retrieval_v2

MECHANICHAT_RETRIEVAL_CANDIDATE_COUNT=8
MECHANICHAT_RETRIEVAL_RESULT_COUNT=3
# Defaults to 0.78 for Nomic and 0.50 for EmbeddingGemma.
# MECHANICHAT_RETRIEVAL_DISTANCE_THRESHOLD=0.50
MECHANICHAT_EMBEDDING_BATCH_SIZE=64

MECHANICHAT_REQUEST_TIMEOUT=120
MECHANICHAT_NHTSA_TIMEOUT=15
MECHANICHAT_MAX_QUEUE_SIZE=5
MECHANICHAT_DEFAULT_GENERATION_SECONDS=30
MECHANICHAT_MAX_IMAGE_SIZE=8388608
MECHANICHAT_MAX_IMAGE_COUNT=5
MECHANICHAT_MAX_IMAGE_PIXELS=25000000
MECHANICHAT_MAX_IMAGE_DIMENSION=2048
MECHANICHAT_TEMPORARY_IMAGE_TTL_SECONDS=900
# Defaults to the operating system's temporary directory when unset.
# MECHANICHAT_TEMPORARY_IMAGE_DIRECTORY=/tmp/mechanichat_uploads
MECHANICHAT_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
